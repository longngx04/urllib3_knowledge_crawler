# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments and local environment files
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Packaging and build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/

# Test, coverage, lint, and type-checker state
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Editors and operating-system files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/

# Raw HTTP cache stays local (regenerable; large). Normalized KB outputs are
# committed so reviewers can inspect / query without re-running a live crawl.
data/raw/**
!data/raw/.gitkeep

# /flow run-state (generated; safe to ignore)
MODE
PROJECT_TYPE
.flow/
flow/.lock
cards/.inflight
