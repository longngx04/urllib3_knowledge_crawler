:17710133,"node_id":"MDQ6VXNlcjE3NzEwMTMz","avatar_url":"https://avatars.githubusercontent.com/u/17710133?v=4","gravatar_id":"","url":"https://api.github.com/users/illia-v","html_url":"https://github.com/illia-v","followers_url":"https://api.github.com/users/illia-v/followers","following_url":"https://api.github.com/users/illia-v/following{/other_user}","gists_url":"https://api.github.com/users/illia-v/gists{/gist_id}","starred_url":"https://api.github.com/users/illia-v/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/illia-v/subscriptions","organizations_url":"https://api.github.com/users/illia-v/orgs","repos_url":"https://api.github.com/users/illia-v/repos","events_url":"https://api.github.com/users/illia-v/events{/privacy}","received_events_url":"https://api.github.com/users/illia-v/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3c6e079d1395ae815484b4a8f0ed7657a4dc8d0f","url":"https://api.github.com/repos/urllib3/urllib3/commits/3c6e079d1395ae815484b4a8f0ed7657a4dc8d0f","html_url":"https://github.com/urllib3/urllib3/commit/3c6e079d1395ae815484b4a8f0ed7657a4dc8d0f"}],"stats":{"total":77,"additions":73,"deletions":4},"files":[{"sha":"7c59df5b3ac860370c2cc13a55ae43aceb4c0b83","filename":".readthedocs.yml","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/urllib3/urllib3/blob/4e98d57809dacab1cbe625fddeec1a290c478ea9/.readthedocs.yml","raw_url":"https://github.com/urllib3/urllib3/raw/4e98d57809dacab1cbe625fddeec1a290c478ea9/.readthedocs.yml","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/.readthedocs.yml?ref=4e98d57809dacab1cbe625fddeec1a290c478ea9","patch":"@@ -3,7 +3,7 @@ version: 2\n build:\n   os: ubuntu-22.04\n   tools:\n-    python: \"3\"\n+    python: \"3.11\"\n \n python:\n   install:"},{"sha":"6c37aeba109c01ecfc928020d0124f37c0ff1ad3","filename":"CHANGES.rst","status":"modified","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/urllib3/urllib3/blob/4e98d57809dacab1cbe625fddeec1a290c478ea9/CHANGES.rst","raw_url":"https://github.com/urllib3/urllib3/raw/4e98d57809dacab1cbe625fddeec1a290c478ea9/CHANGES.rst","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/CHANGES.rst?ref=4e98d57809dacab1cbe625fddeec1a290c478ea9","patch":"@@ -1,3 +1,8 @@\n+2.0.7 (2023-10-17)\n+==================\n+\n+* Made body stripped from HTTP requests changing the request method to GET after HTTP 303 \"See Other\" redirect responses.\n+\n 2.0.6 (2023-10-02)\n ==================\n \n@@ -167,6 +172,11 @@ Fixed\n * Fixed a socket leak if ``HTTPConnection.connect()`` fails (`#2571 <https://github.com/urllib3/urllib3/pull/2571>`__).\n * Fixed ``urllib3.contrib.pyopenssl.WrappedSocket`` and ``urllib3.contrib.securetransport.WrappedSocket`` close methods (`#2970 <https://github.com/urllib3/urllib3/issues/2970>`__)\n \n+1.26.18 (2023-10-17)\n+====================\n+\n+* Made body stripped from HTTP requests changing the request method to GET after HTTP 303 \"See Other\" redirect responses.\n+\n 1.26.17 (2023-10-02)\n ====================\n "},{"sha":"86201a116feb0ad83f03bbed95441d5a0e628a89","filename":"dummyserver/handlers.py","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/urllib3/urllib3/blob/4e98d57809dacab1cbe625fddeec1a290c478ea9/dummyserver%2Fhandlers.py","raw_url":"https://github.com/urllib3/urllib3/raw/4e98d57809dacab1cbe625fddeec1a290c478ea9/dummyserver%2Fhandlers.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/dummyserver%2Fhandlers.py?ref=4e98d57809dacab1cbe625fddeec1a290c478ea9","patch":"@@ -281,6 +281,12 @@ def encodingrequest(self, request: httputil.HTTPServerRequest) -> Response:\n     def headers(self, request: httputil.HTTPServerRequest) -> Response:\n         return Response(json.dumps(dict(request.headers)))\n \n+    def headers_and_params(self, request: httputil.HTTPServerRequest) -> Response:\n+        params = request_params(request)\n+        return Response(\n+            json.dumps({\"headers\": dict(request.headers), \"params\": params})\n+        )\n+\n     def multi_headers(self, request: httputil.HTTPServerRequest) -> Response:\n         return Response(json.dumps({\"headers\": list(request.headers.get_all())}))\n "},{"sha":"55b03247972b3397463cbee9f81ec3d1e131085b","filename":"src/urllib3/_collections.py","status":"modified","additions":20,"deletions":0,"changes":20,"blob_url":"https://github.com/urllib3/urllib3/blob/4e98d57809dacab1cbe625fddeec1a290c478ea9/src%2Furllib3%2F_collections.py","raw_url":"https://github.com/urllib3/urllib3/raw/4e98d57809dacab1cbe625fddeec1a290c478ea9/src%2Furllib3%2F_collections.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/src%2Furllib3%2F_collections.py?ref=4e98d57809dacab1cbe625fddeec1a290c478ea9","patch":"@@ -10,6 +10,8 @@\n     # dependency, and is not available at runtime.\n     from typing import Protocol\n \n+    from typing_extensions import Self\n+\n     class HasGettableStringKeys(Protocol):\n         def keys(self) -> typing.Iterator[str]:\n             ...\n@@ -391,6 +393,24 @@ def getlist(\n             # meets our external interface requirement of `Union[List[str], _DT]`.\n             return vals[1:]\n \n+    def _prepare_for_method_change(self) -> Self:\n+        \"\"\"\n+        Remove content-specific header fields before changing the request\n+        method to GET or HEAD according to RFC 9110, Section 15.4.\n+        \"\"\"\n+        content_specific_headers = [\n+            \"Content-Encoding\",\n+            \"Content-Language\",\n+            \"Content-Location\",\n+            \"Content-Type\",\n+            \"Content-Length\",\n+            \"Digest\",\n+            \"Last-Modified\",\n+        ]\n+        for header in content_specific_headers:\n+            self.discard(header)\n+        return self\n+\n     # Backwards compatibility for httplib\n     getheaders = getlist\n     getallmatchingheaders = getlist"},{"sha":"e2b88f1d680b29becb62e31d7216dc85b540806b","filename":"src/urllib3/_version.py","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/urllib3/urllib3/blob/4e98d57809dacab1cbe625fddeec1a290c478ea9/src%2Furllib3%2F_version.py","raw_url":"https://github.com/urllib3/urllib3/raw/4e98d57809dacab1cbe625fddeec1a290c478ea9/src%2Furllib3%2F_version.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/src%2Furllib3%2F_version.py?ref=4e98d57809dacab1cbe625fddeec1a290c478ea9","patch":"@@ -1,4 +1,4 @@\n # This file is protected via CODEOWNERS\n from __future__ import annotations\n \n-__version__ = \"2.0.6\"\n+__version__ = \"2.0.7\""},{"sha":"70048b7aedcdf2fa5e5975839e25fcfc56b3c4e7","filename":"src/urllib3/connectionpool.py","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/urllib3/urllib3/blob/4e98d57809dacab1cbe625fddeec1a290c478ea9/src%2Furllib3%2Fconnectionpool.py","raw_url":"https://github.com/urllib3/urllib3/raw/4e98d57809dacab1cbe625fddeec1a290c478ea9/src%2Furllib3%2Fconnectionpool.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/src%2Furllib3%2Fconnectionpool.py?ref=4e98d57809dacab1cbe625fddeec1a290c478ea9","patch":"@@ -11,6 +11,7 @@\n from types import TracebackType\n \n from ._base_connection import _TYPE_BODY\n+from ._collections import HTTPHeaderDict\n from ._request_methods import RequestMethods\n from .connection import (\n     BaseSSLError,\n@@ -892,7 +893,11 @@ def urlopen(  # type: ignore[override]\n         redirect_location = redirect and response.get_redirect_location()\n         if redirect_location:\n             if response.status == 303:\n+                # Change the method according to RFC 9110, Section 15.4.4.\n                 method = \"GET\"\n+                # And lose the body not to transfer anything sensitive.\n+                body = None\n+                headers = HTTPHeaderDict(headers)._prepare_for_method_change()\n \n             try:\n                 retries = retries.increment(method, url, response=response, _pool=self)"},{"sha":"8b8fac9e0d050af36ff03f4547b1570775a53690","filename":"src/urllib3/poolmanager.py","status":"modified","additions":5,"deletions":2,"changes":7,"blob_url":"https://github.com/urllib3/urllib3/blob/4e98d57809dacab1cbe625fddeec1a290c478ea9/src%2Furllib3%2Fpoolmanager.py","raw_url":"https://github.com/urllib3/urllib3/raw/4e98d57809dacab1cbe625fddeec1a290c478ea9/src%2Furllib3%2Fpoolmanager.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/src%2Furllib3%2Fpoolmanager.py?ref=4e98d57809dacab1cbe625fddeec1a290c478ea9","patch":"@@ -7,7 +7,7 @@\n from types import TracebackType\n from urllib.parse import urljoin\n \n-from ._collections import RecentlyUsedContainer\n+from ._collections import HTTPHeaderDict, RecentlyUsedContainer\n from ._request_methods import RequestMethods\n from .connection import ProxyConfig\n from .connectionpool import HTTPConnectionPool, HTTPSConnectionPool, port_by_scheme\n@@ -448,9 +448,12 @@ def urlopen(  # type: ignore[override]\n         # Support relative URLs for redirecting.\n         redirect_location = urljoin(url, redirect_location)\n \n-        # RFC 7231, Section 6.4.4\n         if response.status == 303:\n+            # Change the method according to RFC 9110, Section 15.4.4.\n             method = \"GET\"\n+            # And lose the body not to transfer anything sensitive.\n+            kw[\"body\"] = None\n+            kw[\"headers\"] = HTTPHeaderDict(kw[\"headers\"])._prepare_for_method_change()\n \n         retries = kw.get(\"retries\")\n         if not isinstance(retries, Retry):"},{"sha":"ebfaf3878f2af1af5e79a324a58e37aa26026853","filename":"test/with_dummyserver/test_connectionpool.py","status":"modified","additions":11,"deletions":0,"changes":11,"blob_url":"https://github.com/urllib3/urllib3/blob/4e98d57809dacab1cbe625fddeec1a290c478ea9/test%2Fwith_dummyserver%2Ftest_connectionpool.py","raw_url":"https://github.com/urllib3/urllib3/raw/4e98d57809dacab1cbe625fddeec1a290c478ea9/test%2Fwith_dummyserver%2Ftest_connectionpool.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Fwith_dummyserver%2Ftest_connectionpool.py?ref=4e98d57809dacab1cbe625fddeec1a290c478ea9","patch":"@@ -480,6 +480,17 @@ def test_redirect(self) -> None:\n             assert r.status == 200\n             assert r.data == b\"Dummy server!\"\n \n+    def test_303_redirect_makes_request_lose_body(self) -> None:\n+        with HTTPConnectionPool(self.host, self.port) as pool:\n+            response = pool.request(\n+                \"POST\",\n+                \"/redirect\",\n+                fields={\"target\": \"/headers_and_params\", \"status\": \"303 See Other\"},\n+            )\n+        data = response.json()\n+        assert data[\"params\"] == {}\n+        assert \"Content-Type\" not in HTTPHeaderDict(data[\"headers\"])\n+\n     def test_bad_connect(self) -> None:\n         with HTTPConnectionPool(\"badhost.invalid\", self.port) as pool:\n             with pytest.raises(MaxRetryError) as e:"},{"sha":"ab0111e45bd3697b61b2de034183e75af7132841","filename":"test/with_dummyserver/test_poolmanager.py","status":"modified","additions":14,"deletions":0,"changes":14,"blob_url":"https://github.com/urllib3/urllib3/blob/4e98d57809dacab1cbe625fddeec1a290c478ea9/test%2Fwith_dummyserver%2Ftest_poolmanager.py","raw_url":"https://github.com/urllib3/urllib3/raw/4e98d57809dacab1cbe625fddeec1a290c478ea9/test%2Fwith_dummyserver%2Ftest_poolmanager.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Fwith_dummyserver%2Ftest_poolmanager.py?ref=4e98d57809dacab1cbe625fddeec1a290c478ea9","patch":"@@ -244,6 +244,20 @@ def test_redirect_without_preload_releases_connection(self) -> None:\n             assert r._pool.num_connections == 1\n             assert len(http.pools) == 1\n \n+    def test_303_redirect_makes_request_lose_body(self) -> None:\n+        with PoolManager() as http:\n+            response = http.request(\n+                \"POST\",\n+                f\"{self.base_url}/redirect\",\n+                fields={\n+                    \"target\": f\"{self.base_url}/headers_and_params\",\n+                    \"status\": \"303 See Other\",\n+                },\n+            )\n+        data = response.json()\n+        assert data[\"params\"] == {}\n+        assert \"Content-Type\" not in HTTPHeaderDict(data[\"headers\"])\n+\n     def test_unknown_scheme(self) -> None:\n         with PoolManager() as http:\n             unknown_scheme = \"unknown\""}]}