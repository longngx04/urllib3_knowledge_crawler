 os.path.join(CERTS_PATH, 'server.ipv6addr.key'),\n }\n+IPV6_SAN_CERTS = {\n+    'certfile': os.path.join(CERTS_PATH, 'server.ipv6_san.crt'),\n+    'keyfile': DEFAULT_CERTS['keyfile']\n+}\n DEFAULT_CA = os.path.join(CERTS_PATH, 'cacert.pem')\n DEFAULT_CA_BAD = os.path.join(CERTS_PATH, 'client_bad.pem')\n NO_SAN_CA = os.path.join(CERTS_PATH, 'cacert.no_san.pem')\n DEFAULT_CA_DIR = os.path.join(CERTS_PATH, 'ca_path_test')\n IPV6_ADDR_CA = os.path.join(CERTS_PATH, 'server.ipv6addr.crt')\n+IPV6_SAN_CA = os.path.join(CERTS_PATH, 'server.ipv6_san.crt')\n COMBINED_CERT_AND_KEY = os.path.join(CERTS_PATH, 'server.combined.pem')\n \n "},{"sha":"61915465f6c1c777d62ec1971f37a8c19edc570a","filename":"src/urllib3/__init__.py","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/urllib3/urllib3/blob/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/src%2Furllib3%2F__init__.py","raw_url":"https://github.com/urllib3/urllib3/raw/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/src%2Furllib3%2F__init__.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/src%2Furllib3%2F__init__.py?ref=1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1","patch":"@@ -27,7 +27,7 @@\n \n __author__ = 'Andrey Petrov (andrey.petrov@shazow.net)'\n __license__ = 'MIT'\n-__version__ = '1.24.1'\n+__version__ = '1.24.2'\n \n __all__ = (\n     'HTTPConnectionPool',"},{"sha":"5ab7803ac5125c9f18a9c1f1bf147dfe982481d5","filename":"src/urllib3/contrib/pyopenssl.py","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/urllib3/urllib3/blob/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/src%2Furllib3%2Fcontrib%2Fpyopenssl.py","raw_url":"https://github.com/urllib3/urllib3/raw/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/src%2Furllib3%2Fcontrib%2Fpyopenssl.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/src%2Furllib3%2Fcontrib%2Fpyopenssl.py?ref=1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1","patch":"@@ -184,6 +184,9 @@ def idna_encode(name):\n         except idna.core.IDNAError:\n             return None\n \n+    if ':' in name:\n+        return name\n+\n     name = idna_encode(name)\n     if name is None:\n         return None"},{"sha":"32bd973021ac9aaf494e3830ec805bf25e5ae2a7","filename":"src/urllib3/poolmanager.py","status":"modified","additions":5,"deletions":2,"changes":7,"blob_url":"https://github.com/urllib3/urllib3/blob/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/src%2Furllib3%2Fpoolmanager.py","raw_url":"https://github.com/urllib3/urllib3/raw/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/src%2Furllib3%2Fpoolmanager.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/src%2Furllib3%2Fpoolmanager.py?ref=1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1","patch":"@@ -7,6 +7,7 @@\n from .connectionpool import HTTPConnectionPool, HTTPSConnectionPool\n from .connectionpool import port_by_scheme\n from .exceptions import LocationValueError, MaxRetryError, ProxySchemeUnknown\n+from .packages import six\n from .packages.six.moves.urllib.parse import urljoin\n from .request import RequestMethods\n from .util.url import parse_url\n@@ -342,8 +343,10 @@ def urlopen(self, method, url, redirect=True, **kw):\n         # conn.is_same_host() which may use socket.gethostbyname() in the future.\n         if (retries.remove_headers_on_redirect\n                 and not conn.is_same_host(redirect_location)):\n-            for header in retries.remove_headers_on_redirect:\n-                kw['headers'].pop(header, None)\n+            headers = list(six.iterkeys(kw['headers']))\n+            for header in headers:\n+                if header.lower() in retries.remove_headers_on_redirect:\n+                    kw['headers'].pop(header, None)\n \n         try:\n             retries = retries.increment(method, url, response=response, _pool=conn)"},{"sha":"02429ee8e481e724e6473fd9179a49f7f9d85367","filename":"src/urllib3/util/retry.py","status":"modified","additions":2,"deletions":1,"changes":3,"blob_url":"https://github.com/urllib3/urllib3/blob/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/src%2Furllib3%2Futil%2Fretry.py","raw_url":"https://github.com/urllib3/urllib3/raw/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/src%2Furllib3%2Futil%2Fretry.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/src%2Furllib3%2Futil%2Fretry.py?ref=1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1","patch":"@@ -179,7 +179,8 @@ def __init__(self, total=10, connect=None, read=None, redirect=None, status=None\n         self.raise_on_status = raise_on_status\n         self.history = history or tuple()\n         self.respect_retry_after_header = respect_retry_after_header\n-        self.remove_headers_on_redirect = remove_headers_on_redirect\n+        self.remove_headers_on_redirect = frozenset([\n+            h.lower() for h in remove_headers_on_redirect])\n \n     def new(self, **kw):\n         params = dict("},{"sha":"5ae43582736838278d57bd47638046282f302959","filename":"src/urllib3/util/ssl_.py","status":"modified","additions":4,"deletions":1,"changes":5,"blob_url":"https://github.com/urllib3/urllib3/blob/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/src%2Furllib3%2Futil%2Fssl_.py","raw_url":"https://github.com/urllib3/urllib3/raw/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/src%2Furllib3%2Futil%2Fssl_.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/src%2Furllib3%2Futil%2Fssl_.py?ref=1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1","patch":"@@ -327,7 +327,10 @@ def ssl_wrap_socket(sock, keyfile=None, certfile=None, cert_reqs=None,\n             if e.errno == errno.ENOENT:\n                 raise SSLError(e)\n             raise\n-    elif getattr(context, 'load_default_certs', None) is not None:\n+\n+    # Don't load system certs unless there were no CA certs or\n+    # SSLContext object specified manually.\n+    elif ssl_context is None and hasattr(context, 'load_default_certs'):\n         # try to load OS default certs; works well on Windows (require Python3.4+)\n         context.load_default_certs()\n "},{"sha":"f08aa01893ae2606c37daf52b07279d114ba5915","filename":"test/contrib/test_pyopenssl.py","status":"modified","additions":4,"deletions":1,"changes":5,"blob_url":"https://github.com/urllib3/urllib3/blob/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/test%2Fcontrib%2Ftest_pyopenssl.py","raw_url":"https://github.com/urllib3/urllib3/raw/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/test%2Fcontrib%2Ftest_pyopenssl.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Fcontrib%2Ftest_pyopenssl.py?ref=1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1","patch":"@@ -31,7 +31,10 @@ def teardown_module():\n         pass\n \n \n-from ..with_dummyserver.test_https import TestHTTPS, TestHTTPS_TLSv1  # noqa: F401\n+from ..with_dummyserver.test_https import (  # noqa: F401\n+    TestHTTPS, TestHTTPS_TLSv1, TestHTTPS_IPv6Addr,\n+    TestHTTPS_IPSAN, TestHTTPS_NoSAN, TestHTTPS_IPV6SAN\n+)\n from ..with_dummyserver.test_socketlevel import (  # noqa: F401\n     TestSNI, TestSocketClosing, TestClientCerts\n )"},{"sha":"7546c43fea0b1b91120c7552fa3f845cf0f30af9","filename":"test/test_retry.py","status":"modified","additions":3,"deletions":3,"changes":6,"blob_url":"https://github.com/urllib3/urllib3/blob/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/test%2Ftest_retry.py","raw_url":"https://github.com/urllib3/urllib3/raw/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/test%2Ftest_retry.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Ftest_retry.py?ref=1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1","patch":"@@ -253,9 +253,9 @@ def test_retry_method_not_in_whitelist(self):\n     def test_retry_default_remove_headers_on_redirect(self):\n         retry = Retry()\n \n-        assert list(retry.remove_headers_on_redirect) == ['Authorization']\n+        assert list(retry.remove_headers_on_redirect) == ['authorization']\n \n     def test_retry_set_remove_headers_on_redirect(self):\n-        retry = Retry(remove_headers_on_redirect=['X-API-Secret'])\n+        retry = Retry(remove_headers_on_redirect=['x-api-secret'])\n \n-        assert list(retry.remove_headers_on_redirect) == ['X-API-Secret']\n+        assert list(retry.remove_headers_on_redirect) == ['x-api-secret']"},{"sha":"6a46b4f3ea9bedf81214c1d7390e40adb83a7709","filename":"test/test_ssl.py","status":"modified","additions":37,"deletions":0,"changes":37,"blob_url":"https://github.com/urllib3/urllib3/blob/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/test%2Ftest_ssl.py","raw_url":"https://github.com/urllib3/urllib3/raw/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/test%2Ftest_ssl.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Ftest_ssl.py?ref=1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1","patch":"@@ -88,3 +88,40 @@ def test_create_urllib3_context_set_ciphers(monkeypatch, ciphers, expected_ciphe\n \n     assert context.set_ciphers.call_count == 1\n     assert context.set_ciphers.call_args == mock.call(expected_ciphers)\n+\n+\n+def test_wrap_socket_given_context_no_load_default_certs():\n+    context = mock.create_autospec(ssl_.SSLContext)\n+    context.load_default_certs = mock.Mock()\n+\n+    sock = mock.Mock()\n+    ssl_.ssl_wrap_socket(sock, ssl_context=context)\n+\n+    context.load_default_certs.assert_not_called()\n+\n+\n+def test_wrap_socket_given_ca_certs_no_load_default_certs(monkeypatch):\n+    context = mock.create_autospec(ssl_.SSLContext)\n+    context.load_default_certs = mock.Mock()\n+    context.options = 0\n+\n+    monkeypatch.setattr(ssl_, \"SSLContext\", lambda *_, **__: context)\n+\n+    sock = mock.Mock()\n+    ssl_.ssl_wrap_socket(sock, ca_certs=\"/tmp/fake-file\")\n+\n+    context.load_default_certs.assert_not_called()\n+    context.load_verify_locations.assert_called_with(\"/tmp/fake-file\", None)\n+\n+\n+def test_wrap_socket_default_loads_default_certs(monkeypatch):\n+    context = mock.create_autospec(ssl_.SSLContext)\n+    context.load_default_certs = mock.Mock()\n+    context.options = 0\n+\n+    monkeypatch.setattr(ssl_, \"SSLContext\", lambda *_, **__: context)\n+\n+    sock = mock.Mock()\n+    ssl_.ssl_wrap_socket(sock)\n+\n+    context.load_default_certs.assert_called_with()"},{"sha":"acc149c3077690e0903c78603c9691485bd0ac5b","filename":"test/with_dummyserver/test_https.py","status":"modified","additions":19,"deletions":1,"changes":20,"blob_url":"https://github.com/urllib3/urllib3/blob/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/test%2Fwith_dummyserver%2Ftest_https.py","raw_url":"https://github.com/urllib3/urllib3/raw/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/test%2Fwith_dummyserver%2Ftest_https.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Fwith_dummyserver%2Ftest_https.py?ref=1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1","patch":"@@ -17,7 +17,7 @@\n                                 DEFAULT_CLIENT_NO_INTERMEDIATE_CERTS,\n                                 NO_SAN_CERTS, NO_SAN_CA, DEFAULT_CA_DIR,\n                                 IPV6_ADDR_CERTS, IPV6_ADDR_CA, HAS_IPV6,\n-                                IP_SAN_CERTS)\n+                                IP_SAN_CERTS, IPV6_SAN_CA, IPV6_SAN_CERTS)\n \n from test import (\n     onlyPy279OrNewer,\n@@ -625,5 +625,23 @@ def test_strip_square_brackets_before_validating(self):\n         self.assertEqual(r.status, 200)\n \n \n+class TestHTTPS_IPV6SAN(IPV6HTTPSDummyServerTestCase):\n+    certs = IPV6_SAN_CERTS\n+\n+    def test_can_validate_ipv6_san(self):\n+        \"\"\"Ensure that urllib3 can validate SANs with IPv6 addresses in them.\"\"\"\n+        try:\n+            import ipaddress  # noqa: F401\n+        except ImportError:\n+            pytest.skip(\"Only runs on systems with an ipaddress module\")\n+\n+        https_pool = HTTPSConnectionPool('[::1]', self.port,\n+                                         cert_reqs='CERT_REQUIRED',\n+                                         ca_certs=IPV6_SAN_CA)\n+        self.addCleanup(https_pool.close)\n+        r = https_pool.request('GET', '/')\n+        self.assertEqual(r.status, 200)\n+\n+\n if __name__ == '__main__':\n     unittest.main()"},{"sha":"3c1eef8dac120477c19156b5d19a60c2f74c1fc1","filename":"test/with_dummyserver/test_poolmanager.py","status":"modified","additions":26,"deletions":0,"changes":26,"blob_url":"https://github.com/urllib3/urllib3/blob/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/test%2Fwith_dummyserver%2Ftest_poolmanager.py","raw_url":"https://github.com/urllib3/urllib3/raw/1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1/test%2Fwith_dummyserver%2Ftest_poolmanager.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Fwith_dummyserver%2Ftest_poolmanager.py?ref=1efadf43dc63317cd9eaa3e0fdb9e05ab07254b1","patch":"@@ -123,6 +123,17 @@ def test_redirect_cross_host_remove_headers(self):\n \n         self.assertNotIn('Authorization', data)\n \n+        r = http.request('GET', '%s/redirect' % self.base_url,\n+                         fields={'target': '%s/headers' % self.base_url_alt},\n+                         headers={'authorization': 'foo'})\n+\n+        self.assertEqual(r.status, 200)\n+\n+        data = json.loads(r.data.decode('utf-8'))\n+\n+        self.assertNotIn('authorization', data)\n+        self.assertNotIn('Authorization', data)\n+\n     def test_redirect_cross_host_no_remove_headers(self):\n         http = PoolManager()\n         self.addCleanup(http.clear)\n@@ -155,6 +166,21 @@ def test_redirect_cross_host_set_removed_headers(self):\n         self.assertNotIn('X-API-Secret', data)\n         self.assertEqual(data['Authorization'], 'bar')\n \n+        r = http.request('GET', '%s/redirect' % self.base_url,\n+                         fields={'target': '%s/headers' % self.base_url_alt},\n+                         headers={'x-api-secret': 'foo',\n+                                  'authorization': 'bar'},\n+                         retries=Retry(remove_headers_on_redirect=['X-API-Secret']))\n+\n+        self.assertEqual(r.status, 200)\n+\n+        data = json.loads(r.data.decode('utf-8'))\n+\n+        self.assertNotIn('x-api-secret', data)\n+        self.assertNotIn('X-API-Secret', data)\n+\n+        self.assertEqual(data['Authorization'], 'bar')\n+\n     def test_raise_on_redirect(self):\n         http = PoolManager()\n         self.addCleanup(http.clear)"}]}