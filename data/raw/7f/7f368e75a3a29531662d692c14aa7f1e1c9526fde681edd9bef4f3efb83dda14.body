rs/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"29cfd02f66376c61bd20f1725477925106321f68","url":"https://api.github.com/repos/urllib3/urllib3/commits/29cfd02f66376c61bd20f1725477925106321f68","html_url":"https://github.com/urllib3/urllib3/commit/29cfd02f66376c61bd20f1725477925106321f68"}],"stats":{"total":47,"additions":41,"deletions":6},"files":[{"sha":"22af7e3d33c5656795eab655a9bc9db9f4de303e","filename":"CHANGES.rst","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/urllib3/urllib3/blob/40b6d1605814dd1db0a46e202d6e56f2e4c9a468/CHANGES.rst","raw_url":"https://github.com/urllib3/urllib3/raw/40b6d1605814dd1db0a46e202d6e56f2e4c9a468/CHANGES.rst","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/CHANGES.rst?ref=40b6d1605814dd1db0a46e202d6e56f2e4c9a468","patch":"@@ -1,6 +1,11 @@\n Changes\n =======\n \n+1.26.19 (2024-06-17)\n+==================\n+\n+- Added the ``Proxy-Authorization`` header to the list of headers to strip from requests when redirecting to a different host. As before, different headers can be set via ``Retry.remove_headers_on_redirect``.\n+\n 1.26.18 (2023-10-17)\n --------------------\n "},{"sha":"9a1e90d0b236420d7f8b4c5c0325a7c17a1f3703","filename":"src/urllib3/util/retry.py","status":"modified","additions":3,"deletions":1,"changes":4,"blob_url":"https://github.com/urllib3/urllib3/blob/40b6d1605814dd1db0a46e202d6e56f2e4c9a468/src%2Furllib3%2Futil%2Fretry.py","raw_url":"https://github.com/urllib3/urllib3/raw/40b6d1605814dd1db0a46e202d6e56f2e4c9a468/src%2Furllib3%2Futil%2Fretry.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/src%2Furllib3%2Futil%2Fretry.py?ref=40b6d1605814dd1db0a46e202d6e56f2e4c9a468","patch":"@@ -235,7 +235,9 @@ class Retry(object):\n     RETRY_AFTER_STATUS_CODES = frozenset([413, 429, 503])\n \n     #: Default headers to be used for ``remove_headers_on_redirect``\n-    DEFAULT_REMOVE_HEADERS_ON_REDIRECT = frozenset([\"Cookie\", \"Authorization\"])\n+    DEFAULT_REMOVE_HEADERS_ON_REDIRECT = frozenset(\n+        [\"Cookie\", \"Authorization\", \"Proxy-Authorization\"]\n+    )\n \n     #: Maximum backoff time.\n     DEFAULT_BACKOFF_MAX = 120"},{"sha":"36477145f53b926a100296bbb643c789771ec1cb","filename":"test/test_retry.py","status":"modified","additions":5,"deletions":1,"changes":6,"blob_url":"https://github.com/urllib3/urllib3/blob/40b6d1605814dd1db0a46e202d6e56f2e4c9a468/test%2Ftest_retry.py","raw_url":"https://github.com/urllib3/urllib3/raw/40b6d1605814dd1db0a46e202d6e56f2e4c9a468/test%2Ftest_retry.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Ftest_retry.py?ref=40b6d1605814dd1db0a46e202d6e56f2e4c9a468","patch":"@@ -293,7 +293,11 @@ def test_retry_method_not_in_whitelist(self):\n     def test_retry_default_remove_headers_on_redirect(self):\n         retry = Retry()\n \n-        assert retry.remove_headers_on_redirect == {\"authorization\", \"cookie\"}\n+        assert retry.remove_headers_on_redirect == {\n+            \"authorization\",\n+            \"proxy-authorization\",\n+            \"cookie\",\n+        }\n \n     def test_retry_set_remove_headers_on_redirect(self):\n         retry = Retry(remove_headers_on_redirect=[\"X-API-Secret\"])"},{"sha":"e3b69e778fe45c10b299aeec6b837bfeb14c900f","filename":"test/test_retry_deprecated.py","status":"modified","additions":5,"deletions":1,"changes":6,"blob_url":"https://github.com/urllib3/urllib3/blob/40b6d1605814dd1db0a46e202d6e56f2e4c9a468/test%2Ftest_retry_deprecated.py","raw_url":"https://github.com/urllib3/urllib3/raw/40b6d1605814dd1db0a46e202d6e56f2e4c9a468/test%2Ftest_retry_deprecated.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Ftest_retry_deprecated.py?ref=40b6d1605814dd1db0a46e202d6e56f2e4c9a468","patch":"@@ -295,7 +295,11 @@ def test_retry_method_not_in_whitelist(self):\n     def test_retry_default_remove_headers_on_redirect(self):\n         retry = Retry()\n \n-        assert retry.remove_headers_on_redirect == {\"authorization\", \"cookie\"}\n+        assert retry.remove_headers_on_redirect == {\n+            \"authorization\",\n+            \"proxy-authorization\",\n+            \"cookie\",\n+        }\n \n     def test_retry_set_remove_headers_on_redirect(self):\n         retry = Retry(remove_headers_on_redirect=[\"X-API-Secret\"])"},{"sha":"02e3de5ec625c506276342363f5699234233e949","filename":"test/with_dummyserver/test_poolmanager.py","status":"modified","additions":23,"deletions":3,"changes":26,"blob_url":"https://github.com/urllib3/urllib3/blob/40b6d1605814dd1db0a46e202d6e56f2e4c9a468/test%2Fwith_dummyserver%2Ftest_poolmanager.py","raw_url":"https://github.com/urllib3/urllib3/raw/40b6d1605814dd1db0a46e202d6e56f2e4c9a468/test%2Fwith_dummyserver%2Ftest_poolmanager.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Fwith_dummyserver%2Ftest_poolmanager.py?ref=40b6d1605814dd1db0a46e202d6e56f2e4c9a468","patch":"@@ -142,21 +142,30 @@ def test_redirect_cross_host_remove_headers(self):\n                 \"GET\",\n                 \"%s/redirect\" % self.base_url,\n                 fields={\"target\": \"%s/headers\" % self.base_url_alt},\n-                headers={\"Authorization\": \"foo\", \"Cookie\": \"foo=bar\"},\n+                headers={\n+                    \"Authorization\": \"foo\",\n+                    \"Proxy-Authorization\": \"bar\",\n+                    \"Cookie\": \"foo=bar\",\n+                },\n             )\n \n             assert r.status == 200\n \n             data = json.loads(r.data.decode(\"utf-8\"))\n \n             assert \"Authorization\" not in data\n+            assert \"Proxy-Authorization\" not in data\n             assert \"Cookie\" not in data\n \n             r = http.request(\n                 \"GET\",\n                 \"%s/redirect\" % self.base_url,\n                 fields={\"target\": \"%s/headers\" % self.base_url_alt},\n-                headers={\"authorization\": \"foo\", \"cookie\": \"foo=bar\"},\n+                headers={\n+                    \"authorization\": \"foo\",\n+                    \"proxy-authorization\": \"baz\",\n+                    \"cookie\": \"foo=bar\",\n+                },\n             )\n \n             assert r.status == 200\n@@ -165,6 +174,8 @@ def test_redirect_cross_host_remove_headers(self):\n \n             assert \"authorization\" not in data\n             assert \"Authorization\" not in data\n+            assert \"proxy-authorization\" not in data\n+            assert \"Proxy-Authorization\" not in data\n             assert \"cookie\" not in data\n             assert \"Cookie\" not in data\n \n@@ -174,7 +185,11 @@ def test_redirect_cross_host_no_remove_headers(self):\n                 \"GET\",\n                 \"%s/redirect\" % self.base_url,\n                 fields={\"target\": \"%s/headers\" % self.base_url_alt},\n-                headers={\"Authorization\": \"foo\", \"Cookie\": \"foo=bar\"},\n+                headers={\n+                    \"Authorization\": \"foo\",\n+                    \"Proxy-Authorization\": \"bar\",\n+                    \"Cookie\": \"foo=bar\",\n+                },\n                 retries=Retry(remove_headers_on_redirect=[]),\n             )\n \n@@ -183,6 +198,7 @@ def test_redirect_cross_host_no_remove_headers(self):\n             data = json.loads(r.data.decode(\"utf-8\"))\n \n             assert data[\"Authorization\"] == \"foo\"\n+            assert data[\"Proxy-Authorization\"] == \"bar\"\n             assert data[\"Cookie\"] == \"foo=bar\"\n \n     def test_redirect_cross_host_set_removed_headers(self):\n@@ -194,6 +210,7 @@ def test_redirect_cross_host_set_removed_headers(self):\n                 headers={\n                     \"X-API-Secret\": \"foo\",\n                     \"Authorization\": \"bar\",\n+                    \"Proxy-Authorization\": \"baz\",\n                     \"Cookie\": \"foo=bar\",\n                 },\n                 retries=Retry(remove_headers_on_redirect=[\"X-API-Secret\"]),\n@@ -205,6 +222,7 @@ def test_redirect_cross_host_set_removed_headers(self):\n \n             assert \"X-API-Secret\" not in data\n             assert data[\"Authorization\"] == \"bar\"\n+            assert data[\"Proxy-Authorization\"] == \"baz\"\n             assert data[\"Cookie\"] == \"foo=bar\"\n \n             r = http.request(\n@@ -213,6 +231,7 @@ def test_redirect_cross_host_set_removed_headers(self):\n                 fields={\"target\": \"%s/headers\" % self.base_url_alt},\n                 headers={\n                     \"x-api-secret\": \"foo\",\n+                    \"proxy-authorization\": \"baz\",\n                     \"authorization\": \"bar\",\n                     \"cookie\": \"foo=bar\",\n                 },\n@@ -226,6 +245,7 @@ def test_redirect_cross_host_set_removed_headers(self):\n             assert \"x-api-secret\" not in data\n             assert \"X-API-Secret\" not in data\n             assert data[\"Authorization\"] == \"bar\"\n+            assert data[\"Proxy-Authorization\"] == \"baz\"\n             assert data[\"Cookie\"] == \"foo=bar\"\n \n     def test_redirect_without_preload_releases_connection(self):"}]}