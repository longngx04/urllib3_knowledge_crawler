{"sha":"c32cdbc16a9634fa0f8c829d1270301570158715","node_id":"MDY6Q29tbWl0MjQxMDY3NjpjMzJjZGJjMTZhOTYzNGZhMGY4YzgyOWQxMjcwMzAxNTcwMTU4NzE1","commit":{"author":{"name":"Cory Benfield","email":"lukasaoz@gmail.com","date":"2016-10-24T14:19:10Z"},"committer":{"name":"Cory Benfield","email":"lukasaoz@gmail.com","date":"2016-10-27T11:00:36Z"},"message":"CVE-2016-9015: Correct set verify flags.\n\nThis error, introduced in 1.17, causes users using OpenSSL 1.1.0 along\nwith PyOpenSSL to silently fail to validate certificates. This is an\nalarming failure mode, and is currently being worked on as part of\nOpenSSL 1.1.0: https://github.com/openssl/openssl/pull/1793\n\nThis patch will be merged into master in a different form, as part of a\ngeneral testing cleanup. The flaw was discovered by Cory Benfield, and\nwas in fact caught by urllib3's test suite: it just happens that we\nhadn't tested that particular software configuration before releasing\n1.17.","tree":{"sha":"fd5557083009d39199ed0de62061f2df02d92eee","url":"https://api.github.com/repos/urllib3/urllib3/git/trees/fd5557083009d39199ed0de62061f2df02d92eee"},"url":"https://api.github.com/repos/urllib3/urllib3/git/commits/c32cdbc16a9634fa0f8c829d1270301570158715","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\niQIcBAABCAAGBQJYEd5UAAoJEHD+F/imQ+FbtgMP/3eeSqrRrh3jeFWMXtdpQE9M\nHybe0DaUVaraAEg/Zg6uYB7Mp1Qh7MLi38wuWAl4RwNtb+Q/35jCjnkGDv/v421W\nvix8FCy3p8OckK3FKAdaenuY6Qno7bZhzVbRLBZyykXcLXD6KBSpDR8thz20u62B\nygZqi9CHNrz+tsL0iGlJzHh9OTQJiu8aS552R53TBeQxxxfs2c4qs3d9J768IMM3\nWeMw4PWb3UiD1WCVjP1UxUGpMKbAa6yhz2OKvh3FQ92dEQgsh/CNGxWKNCM9GkZU\nhWeAb5ULcUkk8SLbQomyTzQZeLVur7t/T8ALhgYVPd0R6DgwmGyCJnvNcAh7Zfuo\nBhz5bi6vTTMCWdYjqcdxBwqPw2gvqFKN744JV+SxLfuH+zfKKilW6w5yh2IImvkl\nfm1iRjvQNkvrj0Jz2OJMgAjFhoTk/Vqi3xoFgrOAesAKVJINA3Keudnl8uLWPzR5\nhERRYalSYCnmvx+68f1KY7LPoU0+b76ZBOuUR/uqZlYxUbc8uC9phlv8BZRotO2E\nYv0slgglmf3MHAdajE06jnJ0sRvZ7XCJDqVGy8iy+FKpgenYPTGu/qLWu/s/OAs4\noFvXs/p4TAl8HzxkSjZMZYLUGwaZNN8pnTHdBMznXd3ntasa5FNSdd42ezNFaL8V\n4jSbOS4vXnMm4lLfrL+T\n=3Rpl\n-----END PGP SIGNATURE-----","payload":"tree fd5557083009d39199ed0de62061f2df02d92eee\nparent 7d01b990cf77b33659e562189e6962862b292170\nauthor Cory Benfield <lukasaoz@gmail.com> 1477318750 +0100\ncommitter Cory Benfield <lukasaoz@gmail.com> 1477566036 +0100\n\nCVE-2016-9015: Correct set verify flags.\n\nThis error, introduced in 1.17, causes users using OpenSSL 1.1.0 along\nwith PyOpenSSL to silently fail to validate certificates. This is an\nalarming failure mode, and is currently being worked on as part of\nOpenSSL 1.1.0: https://github.com/openssl/openssl/pull/1793\n\nThis patch will be merged into master in a different form, as part of a\ngeneral testing cleanup. The flaw was discovered by Cory Benfield, and\nwas in fact caught by urllib3's test suite: it just happens that we\nhadn't tested that particular software configuration before releasing\n1.17.\n","verified_at":"2024-11-07T22:38:35Z"}},"url":"https://api.github.com/repos/urllib3/urllib3/commits/c32cdbc16a9634fa0f8c829d1270301570158715","html_url":"https://github.com/urllib3/urllib3/commit/c32cdbc16a9634fa0f8c829d1270301570158715","comments_url":"https://api.github.com/repos/urllib3/urllib3/commits/c32cdbc16a9634fa0f8c829d1270301570158715/comments","author":{"login":"Lukasa","id":1382556,"node_id":"MDQ6VXNlcjEzODI1NTY=","avatar_url":"https://avatars.githubusercontent.com/u/1382556?v=4","gravatar_id":"","url":"https://api.github.com/users/Lukasa","html_url":"https://github.com/Lukasa","followers_url":"https://api.github.com/users/Lukasa/followers","following_url":"https://api.github.com/users/Lukasa/following{/other_user}","gists_url":"https://api.github.com/users/Lukasa/gists{/gist_id}","starred_url":"https://api.github.com/users/Lukasa/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lukasa/subscriptions","organizations_url":"https://api.github.com/users/Lukasa/orgs","repos_url":"https://api.github.com/users/Lukasa/repos","events_url":"https://api.github.com/users/Lukasa/events{/privacy}","received_events_url":"https://api.github.com/users/Lukasa/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Lukasa","id":1382556,"node_id":"MDQ6VXNlcjEzODI1NTY=","avatar_url":"https://avatars.githubusercontent.com/u/1382556?v=4","gravatar_id":"","url":"https://api.github.com/users/Lukasa","html_url":"https://github.com/Lukasa","followers_url":"https://api.github.com/users/Lukasa/followers","following_url":"https://api.github.com/users/Lukasa/following{/other_user}","gists_url":"https://api.github.com/users/Lukasa/gists{/gist_id}","starred_url":"https://api.github.com/users/Lukasa/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Lukasa/subscriptions","organizations_url":"https://api.github.com/users/Lukasa/orgs","repos_url":"https://api.github.com/users/Lukasa/repos","events_url":"https://api.github.com/users/Lukasa/events{/privacy}","received_events_url":"https://api.github.com/users/Lukasa/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"7d01b990cf77b33659e562189e6962862b292170","url":"https://api.github.com/repos/urllib3/urllib3/commits/7d01b990cf77b33659e562189e6962862b292170","html_url":"https://github.com/urllib3/urllib3/commit/7d01b990cf77b33659e562189e6962862b292170"}],"stats":{"total":13,"additions":9,"deletions":4},"files":[{"sha":"0a3a5e5543c1294f86d15d7e39912439f4152d95","filename":"urllib3/contrib/pyopenssl.py","status":"modified","additions":9,"deletions":4,"changes":13,"blob_url":"https://github.com/urllib3/urllib3/blob/c32cdbc16a9634fa0f8c829d1270301570158715/urllib3%2Fcontrib%2Fpyopenssl.py","raw_url":"https://github.com/urllib3/urllib3/raw/c32cdbc16a9634fa0f8c829d1270301570158715/urllib3%2Fcontrib%2Fpyopenssl.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/urllib3%2Fcontrib%2Fpyopenssl.py?ref=c32cdbc16a9634fa0f8c829d1270301570158715","patch":"@@ -88,12 +88,15 @@\n except AttributeError:\n     pass\n \n-_openssl_verify = {\n+_stdlib_to_openssl_verify = {\n     ssl.CERT_NONE: OpenSSL.SSL.VERIFY_NONE,\n     ssl.CERT_OPTIONAL: OpenSSL.SSL.VERIFY_PEER,\n     ssl.CERT_REQUIRED:\n         OpenSSL.SSL.VERIFY_PEER + OpenSSL.SSL.VERIFY_FAIL_IF_NO_PEER_CERT,\n }\n+_openssl_to_stdlib_verify = dict(\n+    (v, k) for k, v in _stdlib_to_openssl_verify.items()\n+)\n \n #: The list of supported SSL/TLS cipher suites.\n DEFAULT_SSL_CIPHER_LIST = util.ssl_.DEFAULT_CIPHERS.encode('ascii')\n@@ -367,11 +370,13 @@ def options(self, value):\n \n     @property\n     def verify_mode(self):\n-        return self._ctx.get_verify_mode()\n+        return _openssl_to_stdlib_verify[self._ctx.get_verify_mode()]\n \n     @verify_mode.setter\n     def verify_mode(self, value):\n-        self._ctx.set_verify(value, _verify_callback)\n+        self._ctx.set_verify(\n+            _stdlib_to_openssl_verify[value], _verify_callback\n+        )\n \n     def set_default_verify_paths(self):\n         self._ctx.set_default_verify_paths()\n@@ -440,7 +445,7 @@ def ssl_wrap_socket(sock, keyfile=None, certfile=None, cert_reqs=None,\n     if keyfile:\n         ctx.use_privatekey_file(keyfile)\n     if cert_reqs != ssl.CERT_NONE:\n-        ctx.set_verify(_openssl_verify[cert_reqs], _verify_callback)\n+        ctx.set_verify(_stdlib_to_openssl_verify[cert_reqs], _verify_callback)\n     if ca_certs or ca_cert_dir:\n         try:\n             ctx.load_verify_locations(ca_certs, ca_cert_dir)"}]}