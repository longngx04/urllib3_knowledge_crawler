false},"parents":[{"sha":"e63989f97d206e839ab9170c8a76e3e097cc60e8","url":"https://api.github.com/repos/urllib3/urllib3/commits/e63989f97d206e839ab9170c8a76e3e097cc60e8","html_url":"https://github.com/urllib3/urllib3/commit/e63989f97d206e839ab9170c8a76e3e097cc60e8"}],"stats":{"total":38,"additions":29,"deletions":9},"files":[{"sha":"2fc1ac5a3d483a919a29a670d370b96e1a6abc26","filename":"CHANGES.rst","status":"modified","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/urllib3/urllib3/blob/01220354d389cd05474713f8c982d05c9b17aafb/CHANGES.rst","raw_url":"https://github.com/urllib3/urllib3/raw/01220354d389cd05474713f8c982d05c9b17aafb/CHANGES.rst","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/CHANGES.rst?ref=01220354d389cd05474713f8c982d05c9b17aafb","patch":"@@ -1,6 +1,12 @@\n Changes\n =======\n \n+1.26.17 (2023-10-02)\n+--------------------\n+\n+* Added the ``Cookie`` header to the list of headers to strip from requests when redirecting to a different host. As before, different headers can be set via ``Retry.remove_headers_on_redirect``.\n+\n+\n 1.26.16 (2023-05-23)\n --------------------\n "},{"sha":"60ef6c4f3f9d0b6ec8d8c6ef5fc0f20267c3e6d3","filename":"src/urllib3/util/retry.py","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/urllib3/urllib3/blob/01220354d389cd05474713f8c982d05c9b17aafb/src%2Furllib3%2Futil%2Fretry.py","raw_url":"https://github.com/urllib3/urllib3/raw/01220354d389cd05474713f8c982d05c9b17aafb/src%2Furllib3%2Futil%2Fretry.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/src%2Furllib3%2Futil%2Fretry.py?ref=01220354d389cd05474713f8c982d05c9b17aafb","patch":"@@ -235,7 +235,7 @@ class Retry(object):\n     RETRY_AFTER_STATUS_CODES = frozenset([413, 429, 503])\n \n     #: Default headers to be used for ``remove_headers_on_redirect``\n-    DEFAULT_REMOVE_HEADERS_ON_REDIRECT = frozenset([\"Authorization\"])\n+    DEFAULT_REMOVE_HEADERS_ON_REDIRECT = frozenset([\"Cookie\", \"Authorization\"])\n \n     #: Maximum backoff time.\n     DEFAULT_BACKOFF_MAX = 120"},{"sha":"95a33e7461def6a579ffb92189f860e35f918240","filename":"test/test_retry.py","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/urllib3/urllib3/blob/01220354d389cd05474713f8c982d05c9b17aafb/test%2Ftest_retry.py","raw_url":"https://github.com/urllib3/urllib3/raw/01220354d389cd05474713f8c982d05c9b17aafb/test%2Ftest_retry.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Ftest_retry.py?ref=01220354d389cd05474713f8c982d05c9b17aafb","patch":"@@ -293,12 +293,12 @@ def test_retry_method_not_in_whitelist(self):\n     def test_retry_default_remove_headers_on_redirect(self):\n         retry = Retry()\n \n-        assert list(retry.remove_headers_on_redirect) == [\"authorization\"]\n+        assert retry.remove_headers_on_redirect == {\"authorization\", \"cookie\"}\n \n     def test_retry_set_remove_headers_on_redirect(self):\n         retry = Retry(remove_headers_on_redirect=[\"X-API-Secret\"])\n \n-        assert list(retry.remove_headers_on_redirect) == [\"x-api-secret\"]\n+        assert retry.remove_headers_on_redirect == {\"x-api-secret\"}\n \n     @pytest.mark.parametrize(\"value\", [\"-1\", \"+1\", \"1.0\", six.u(\"\\xb2\")])  # \\xb2 = ^2\n     def test_parse_retry_after_invalid(self, value):"},{"sha":"5133a51afa37749d72e200638c76088a0ea12cbf","filename":"test/test_retry_deprecated.py","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/urllib3/urllib3/blob/01220354d389cd05474713f8c982d05c9b17aafb/test%2Ftest_retry_deprecated.py","raw_url":"https://github.com/urllib3/urllib3/raw/01220354d389cd05474713f8c982d05c9b17aafb/test%2Ftest_retry_deprecated.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Ftest_retry_deprecated.py?ref=01220354d389cd05474713f8c982d05c9b17aafb","patch":"@@ -295,7 +295,7 @@ def test_retry_method_not_in_whitelist(self):\n     def test_retry_default_remove_headers_on_redirect(self):\n         retry = Retry()\n \n-        assert list(retry.remove_headers_on_redirect) == [\"authorization\"]\n+        assert retry.remove_headers_on_redirect == {\"authorization\", \"cookie\"}\n \n     def test_retry_set_remove_headers_on_redirect(self):\n         retry = Retry(remove_headers_on_redirect=[\"X-API-Secret\"])"},{"sha":"02a38115c5a14945429fc22256da58f7ee844220","filename":"test/with_dummyserver/test_poolmanager.py","status":"modified","additions":19,"deletions":5,"changes":24,"blob_url":"https://github.com/urllib3/urllib3/blob/01220354d389cd05474713f8c982d05c9b17aafb/test%2Fwith_dummyserver%2Ftest_poolmanager.py","raw_url":"https://github.com/urllib3/urllib3/raw/01220354d389cd05474713f8c982d05c9b17aafb/test%2Fwith_dummyserver%2Ftest_poolmanager.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Fwith_dummyserver%2Ftest_poolmanager.py?ref=01220354d389cd05474713f8c982d05c9b17aafb","patch":"@@ -141,20 +141,21 @@ def test_redirect_cross_host_remove_headers(self):\n                 \"GET\",\n                 \"%s/redirect\" % self.base_url,\n                 fields={\"target\": \"%s/headers\" % self.base_url_alt},\n-                headers={\"Authorization\": \"foo\"},\n+                headers={\"Authorization\": \"foo\", \"Cookie\": \"foo=bar\"},\n             )\n \n             assert r.status == 200\n \n             data = json.loads(r.data.decode(\"utf-8\"))\n \n             assert \"Authorization\" not in data\n+            assert \"Cookie\" not in data\n \n             r = http.request(\n                 \"GET\",\n                 \"%s/redirect\" % self.base_url,\n                 fields={\"target\": \"%s/headers\" % self.base_url_alt},\n-                headers={\"authorization\": \"foo\"},\n+                headers={\"authorization\": \"foo\", \"cookie\": \"foo=bar\"},\n             )\n \n             assert r.status == 200\n@@ -163,14 +164,16 @@ def test_redirect_cross_host_remove_headers(self):\n \n             assert \"authorization\" not in data\n             assert \"Authorization\" not in data\n+            assert \"cookie\" not in data\n+            assert \"Cookie\" not in data\n \n     def test_redirect_cross_host_no_remove_headers(self):\n         with PoolManager() as http:\n             r = http.request(\n                 \"GET\",\n                 \"%s/redirect\" % self.base_url,\n                 fields={\"target\": \"%s/headers\" % self.base_url_alt},\n-                headers={\"Authorization\": \"foo\"},\n+                headers={\"Authorization\": \"foo\", \"Cookie\": \"foo=bar\"},\n                 retries=Retry(remove_headers_on_redirect=[]),\n             )\n \n@@ -179,14 +182,19 @@ def test_redirect_cross_host_no_remove_headers(self):\n             data = json.loads(r.data.decode(\"utf-8\"))\n \n             assert data[\"Authorization\"] == \"foo\"\n+            assert data[\"Cookie\"] == \"foo=bar\"\n \n     def test_redirect_cross_host_set_removed_headers(self):\n         with PoolManager() as http:\n             r = http.request(\n                 \"GET\",\n                 \"%s/redirect\" % self.base_url,\n                 fields={\"target\": \"%s/headers\" % self.base_url_alt},\n-                headers={\"X-API-Secret\": \"foo\", \"Authorization\": \"bar\"},\n+                headers={\n+                    \"X-API-Secret\": \"foo\",\n+                    \"Authorization\": \"bar\",\n+                    \"Cookie\": \"foo=bar\",\n+                },\n                 retries=Retry(remove_headers_on_redirect=[\"X-API-Secret\"]),\n             )\n \n@@ -196,12 +204,17 @@ def test_redirect_cross_host_set_removed_headers(self):\n \n             assert \"X-API-Secret\" not in data\n             assert data[\"Authorization\"] == \"bar\"\n+            assert data[\"Cookie\"] == \"foo=bar\"\n \n             r = http.request(\n                 \"GET\",\n                 \"%s/redirect\" % self.base_url,\n                 fields={\"target\": \"%s/headers\" % self.base_url_alt},\n-                headers={\"x-api-secret\": \"foo\", \"authorization\": \"bar\"},\n+                headers={\n+                    \"x-api-secret\": \"foo\",\n+                    \"authorization\": \"bar\",\n+                    \"cookie\": \"foo=bar\",\n+                },\n                 retries=Retry(remove_headers_on_redirect=[\"X-API-Secret\"]),\n             )\n \n@@ -212,6 +225,7 @@ def test_redirect_cross_host_set_removed_headers(self):\n             assert \"x-api-secret\" not in data\n             assert \"X-API-Secret\" not in data\n             assert data[\"Authorization\"] == \"bar\"\n+            assert data[\"Cookie\"] == \"foo=bar\"\n \n     def test_redirect_without_preload_releases_connection(self):\n         with PoolManager(block=True, maxsize=2) as http:"}]}