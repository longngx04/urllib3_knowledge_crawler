          host, port = _HOST_PORT_RE.match(host_port).groups()\n             if auth and normalize_uri:\n                 auth = _encode_invalid_chars(auth, USERINFO_CHARS)\n             if port == \"\":"},{"sha":"88409e2d6c4541f66b3d6163763eec7cd0265353","filename":"test/test_util.py","status":"modified","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/urllib3/urllib3/blob/2d4a3fee6de2fa45eb82169361918f759269b4ec/test%2Ftest_util.py","raw_url":"https://github.com/urllib3/urllib3/raw/2d4a3fee6de2fa45eb82169361918f759269b4ec/test%2Ftest_util.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Ftest_util.py?ref=2d4a3fee6de2fa45eb82169361918f759269b4ec","patch":"@@ -438,6 +438,16 @@ def test_netloc(self, url, expected_netloc):\n                 fragment=\"hash\",\n             ),\n         ),\n+        # Tons of '@' causing backtracking\n+        (\"https://\" + (\"@\" * 10000) + \"[\", False),\n+        (\n+            \"https://user:\" + (\"@\" * 10000) + \"example.com\",\n+            Url(\n+                scheme=\"https\",\n+                auth=\"user:\" + (\"%40\" * 9999),\n+                host=\"example.com\",\n+            ),\n+        ),\n     ]\n \n     @pytest.mark.parametrize(\"url, expected_url\", url_vulnerabilities)"}]}