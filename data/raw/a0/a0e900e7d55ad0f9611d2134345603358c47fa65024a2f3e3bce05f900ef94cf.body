"additions":35,"deletions":9},"files":[{"sha":"e551cbea408cadc2f4174bfbf9aa9d40657685e1","filename":"CHANGES.rst","status":"modified","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/urllib3/urllib3/blob/644124ecd0b6e417c527191f866daa05a5a2056d/CHANGES.rst","raw_url":"https://github.com/urllib3/urllib3/raw/644124ecd0b6e417c527191f866daa05a5a2056d/CHANGES.rst","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/CHANGES.rst?ref=644124ecd0b6e417c527191f866daa05a5a2056d","patch":"@@ -1,3 +1,8 @@\n+2.0.6 (2023-10-02)\n+==================\n+\n+* Added the ``Cookie`` header to the list of headers to strip from requests when redirecting to a different host. As before, different headers can be set via ``Retry.remove_headers_on_redirect``.\n+\n 2.0.5 (2023-09-20)\n ==================\n "},{"sha":"9416fe126352a1177d1b7aba53dbfc3616b7b7bf","filename":"docs/user-guide.rst","status":"modified","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/urllib3/urllib3/blob/644124ecd0b6e417c527191f866daa05a5a2056d/docs%2Fuser-guide.rst","raw_url":"https://github.com/urllib3/urllib3/raw/644124ecd0b6e417c527191f866daa05a5a2056d/docs%2Fuser-guide.rst","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/docs%2Fuser-guide.rst?ref=644124ecd0b6e417c527191f866daa05a5a2056d","patch":"@@ -238,6 +238,9 @@ the ``;`` delimited key-value pairs:\n     print(resp.json())\n     # {\"cookies\": {\"id\": \"30\", \"session\": \"f3efe9db\"}}  \n \n+Note that the ``Cookie`` header will be stripped if the server redirects to a\n+different host.\n+\n Cookies provided by the server are stored in the ``Set-Cookie`` header:\n \n .. code-block:: python"},{"sha":"7572bfd26ad87711d67c3418a6a0ac9921fed08c","filename":"src/urllib3/util/retry.py","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/urllib3/urllib3/blob/644124ecd0b6e417c527191f866daa05a5a2056d/src%2Furllib3%2Futil%2Fretry.py","raw_url":"https://github.com/urllib3/urllib3/raw/644124ecd0b6e417c527191f866daa05a5a2056d/src%2Furllib3%2Futil%2Fretry.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/src%2Furllib3%2Futil%2Fretry.py?ref=644124ecd0b6e417c527191f866daa05a5a2056d","patch":"@@ -187,7 +187,7 @@ class Retry:\n     RETRY_AFTER_STATUS_CODES = frozenset([413, 429, 503])\n \n     #: Default headers to be used for ``remove_headers_on_redirect``\n-    DEFAULT_REMOVE_HEADERS_ON_REDIRECT = frozenset([\"Authorization\"])\n+    DEFAULT_REMOVE_HEADERS_ON_REDIRECT = frozenset([\"Cookie\", \"Authorization\"])\n \n     #: Default maximum backoff time.\n     DEFAULT_BACKOFF_MAX = 120"},{"sha":"f71e7acc9e565d461680f28564915ffc9e451e06","filename":"test/test_retry.py","status":"modified","additions":2,"deletions":2,"changes":4,"blob_url":"https://github.com/urllib3/urllib3/blob/644124ecd0b6e417c527191f866daa05a5a2056d/test%2Ftest_retry.py","raw_url":"https://github.com/urllib3/urllib3/raw/644124ecd0b6e417c527191f866daa05a5a2056d/test%2Ftest_retry.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Ftest_retry.py?ref=644124ecd0b6e417c527191f866daa05a5a2056d","patch":"@@ -334,12 +334,12 @@ def test_retry_method_not_allowed(self) -> None:\n     def test_retry_default_remove_headers_on_redirect(self) -> None:\n         retry = Retry()\n \n-        assert list(retry.remove_headers_on_redirect) == [\"authorization\"]\n+        assert retry.remove_headers_on_redirect == {\"authorization\", \"cookie\"}\n \n     def test_retry_set_remove_headers_on_redirect(self) -> None:\n         retry = Retry(remove_headers_on_redirect=[\"X-API-Secret\"])\n \n-        assert list(retry.remove_headers_on_redirect) == [\"x-api-secret\"]\n+        assert retry.remove_headers_on_redirect == {\"x-api-secret\"}\n \n     @pytest.mark.parametrize(\"value\", [\"-1\", \"+1\", \"1.0\", \"\\xb2\"])  # \\xb2 = ^2\n     def test_parse_retry_after_invalid(self, value: str) -> None:"},{"sha":"da802a38b3b730c593b67f8e09805e227573ded1","filename":"test/with_dummyserver/test_poolmanager.py","status":"modified","additions":24,"deletions":6,"changes":30,"blob_url":"https://github.com/urllib3/urllib3/blob/644124ecd0b6e417c527191f866daa05a5a2056d/test%2Fwith_dummyserver%2Ftest_poolmanager.py","raw_url":"https://github.com/urllib3/urllib3/raw/644124ecd0b6e417c527191f866daa05a5a2056d/test%2Fwith_dummyserver%2Ftest_poolmanager.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Fwith_dummyserver%2Ftest_poolmanager.py?ref=644124ecd0b6e417c527191f866daa05a5a2056d","patch":"@@ -141,20 +141,21 @@ def test_redirect_cross_host_remove_headers(self) -> None:\n                 \"GET\",\n                 f\"{self.base_url}/redirect\",\n                 fields={\"target\": f\"{self.base_url_alt}/headers\"},\n-                headers={\"Authorization\": \"foo\"},\n+                headers={\"Authorization\": \"foo\", \"Cookie\": \"foo=bar\"},\n             )\n \n             assert r.status == 200\n \n             data = r.json()\n \n             assert \"Authorization\" not in data\n+            assert \"Cookie\" not in data\n \n             r = http.request(\n                 \"GET\",\n                 f\"{self.base_url}/redirect\",\n                 fields={\"target\": f\"{self.base_url_alt}/headers\"},\n-                headers={\"authorization\": \"foo\"},\n+                headers={\"authorization\": \"foo\", \"cookie\": \"foo=bar\"},\n             )\n \n             assert r.status == 200\n@@ -163,14 +164,16 @@ def test_redirect_cross_host_remove_headers(self) -> None:\n \n             assert \"authorization\" not in data\n             assert \"Authorization\" not in data\n+            assert \"cookie\" not in data\n+            assert \"Cookie\" not in data\n \n     def test_redirect_cross_host_no_remove_headers(self) -> None:\n         with PoolManager() as http:\n             r = http.request(\n                 \"GET\",\n                 f\"{self.base_url}/redirect\",\n                 fields={\"target\": f\"{self.base_url_alt}/headers\"},\n-                headers={\"Authorization\": \"foo\"},\n+                headers={\"Authorization\": \"foo\", \"Cookie\": \"foo=bar\"},\n                 retries=Retry(remove_headers_on_redirect=[]),\n             )\n \n@@ -179,14 +182,19 @@ def test_redirect_cross_host_no_remove_headers(self) -> None:\n             data = r.json()\n \n             assert data[\"Authorization\"] == \"foo\"\n+            assert data[\"Cookie\"] == \"foo=bar\"\n \n     def test_redirect_cross_host_set_removed_headers(self) -> None:\n         with PoolManager() as http:\n             r = http.request(\n                 \"GET\",\n                 f\"{self.base_url}/redirect\",\n                 fields={\"target\": f\"{self.base_url_alt}/headers\"},\n-                headers={\"X-API-Secret\": \"foo\", \"Authorization\": \"bar\"},\n+                headers={\n+                    \"X-API-Secret\": \"foo\",\n+                    \"Authorization\": \"bar\",\n+                    \"Cookie\": \"foo=bar\",\n+                },\n                 retries=Retry(remove_headers_on_redirect=[\"X-API-Secret\"]),\n             )\n \n@@ -196,8 +204,13 @@ def test_redirect_cross_host_set_removed_headers(self) -> None:\n \n             assert \"X-API-Secret\" not in data\n             assert data[\"Authorization\"] == \"bar\"\n+            assert data[\"Cookie\"] == \"foo=bar\"\n \n-            headers = {\"x-api-secret\": \"foo\", \"authorization\": \"bar\"}\n+            headers = {\n+                \"x-api-secret\": \"foo\",\n+                \"authorization\": \"bar\",\n+                \"cookie\": \"foo=bar\",\n+            }\n             r = http.request(\n                 \"GET\",\n                 f\"{self.base_url}/redirect\",\n@@ -213,9 +226,14 @@ def test_redirect_cross_host_set_removed_headers(self) -> None:\n             assert \"x-api-secret\" not in data\n             assert \"X-API-Secret\" not in data\n             assert data[\"Authorization\"] == \"bar\"\n+            assert data[\"Cookie\"] == \"foo=bar\"\n \n             # Ensure the header argument itself is not modified in-place.\n-            assert headers == {\"x-api-secret\": \"foo\", \"authorization\": \"bar\"}\n+            assert headers == {\n+                \"x-api-secret\": \"foo\",\n+                \"authorization\": \"bar\",\n+                \"cookie\": \"foo=bar\",\n+            }\n \n     def test_redirect_without_preload_releases_connection(self) -> None:\n         with PoolManager(block=True, maxsize=2) as http:"}]}