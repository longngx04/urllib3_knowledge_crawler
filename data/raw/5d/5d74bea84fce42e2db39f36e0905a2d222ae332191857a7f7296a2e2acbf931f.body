uery parameter\n\n* Add a changelog entry","verified_at":"2026-01-07T16:07:35Z"}},"url":"https://api.github.com/repos/urllib3/urllib3/commits/8864ac407bba8607950025e0979c4c69bc7abc7b","html_url":"https://github.com/urllib3/urllib3/commit/8864ac407bba8607950025e0979c4c69bc7abc7b","comments_url":"https://api.github.com/repos/urllib3/urllib3/commits/8864ac407bba8607950025e0979c4c69bc7abc7b/comments","author":{"login":"illia-v","id":17710133,"node_id":"MDQ6VXNlcjE3NzEwMTMz","avatar_url":"https://avatars.githubusercontent.com/u/17710133?v=4","gravatar_id":"","url":"https://api.github.com/users/illia-v","html_url":"https://github.com/illia-v","followers_url":"https://api.github.com/users/illia-v/followers","following_url":"https://api.github.com/users/illia-v/following{/other_user}","gists_url":"https://api.github.com/users/illia-v/gists{/gist_id}","starred_url":"https://api.github.com/users/illia-v/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/illia-v/subscriptions","organizations_url":"https://api.github.com/users/illia-v/orgs","repos_url":"https://api.github.com/users/illia-v/repos","events_url":"https://api.github.com/users/illia-v/events{/privacy}","received_events_url":"https://api.github.com/users/illia-v/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"70cecb27ca99d56aaaeb63ac27ee270ef2b24c5c","url":"https://api.github.com/repos/urllib3/urllib3/commits/70cecb27ca99d56aaaeb63ac27ee270ef2b24c5c","html_url":"https://github.com/urllib3/urllib3/commit/70cecb27ca99d56aaaeb63ac27ee270ef2b24c5c"}],"stats":{"total":46,"additions":44,"deletions":2},"files":[{"sha":"4c0b9cea87e410e922ac86d22ff3444e0c3813f2","filename":"CHANGES.rst","status":"modified","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/urllib3/urllib3/blob/8864ac407bba8607950025e0979c4c69bc7abc7b/CHANGES.rst","raw_url":"https://github.com/urllib3/urllib3/raw/8864ac407bba8607950025e0979c4c69bc7abc7b/CHANGES.rst","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/CHANGES.rst?ref=8864ac407bba8607950025e0979c4c69bc7abc7b","patch":"@@ -1,3 +1,16 @@\n+2.6.3 (TBD)\n+==================\n+\n+Bugfixes\n+--------\n+\n+- Fixed a high-severity security issue where decompression-bomb safeguards of\n+  the streaming API were bypassed when HTTP redirects were followed.\n+  (`GHSA-38jv-5279-wg99 <https://github.com/urllib3/urllib3/security/advisories/GHSA-38jv-5279-wg99>`__)\n+\n+TODO: add other entries.\n+\n+\n 2.6.2 (2025-12-11)\n ==================\n "},{"sha":"5b82e9329d88b6e993841b75c466fbcac2ccc913","filename":"dummyserver/app.py","status":"modified","additions":7,"deletions":1,"changes":8,"blob_url":"https://github.com/urllib3/urllib3/blob/8864ac407bba8607950025e0979c4c69bc7abc7b/dummyserver%2Fapp.py","raw_url":"https://github.com/urllib3/urllib3/raw/8864ac407bba8607950025e0979c4c69bc7abc7b/dummyserver%2Fapp.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/dummyserver%2Fapp.py?ref=8864ac407bba8607950025e0979c4c69bc7abc7b","patch":"@@ -233,10 +233,16 @@ async def redirect() -> ResponseReturnValue:\n     values = await request.values\n     target = values.get(\"target\", \"/\")\n     status = values.get(\"status\", \"303 See Other\")\n+    compressed = values.get(\"compressed\") == \"true\"\n     status_code = status.split(\" \")[0]\n \n     headers = [(\"Location\", target)]\n-    return await make_response(\"\", status_code, headers)\n+    if compressed:\n+        headers.append((\"Content-Encoding\", \"gzip\"))\n+        data = gzip.compress(b\"foo\")\n+    else:\n+        data = b\"\"\n+    return await make_response(data, status_code, headers)\n \n \n @hypercorn_app.route(\"/redirect_after\")"},{"sha":"ff6d1f4911c2e304a2d7822059d9574536f81aea","filename":"src/urllib3/response.py","status":"modified","additions":5,"deletions":1,"changes":6,"blob_url":"https://github.com/urllib3/urllib3/blob/8864ac407bba8607950025e0979c4c69bc7abc7b/src%2Furllib3%2Fresponse.py","raw_url":"https://github.com/urllib3/urllib3/raw/8864ac407bba8607950025e0979c4c69bc7abc7b/src%2Furllib3%2Fresponse.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/src%2Furllib3%2Fresponse.py?ref=8864ac407bba8607950025e0979c4c69bc7abc7b","patch":"@@ -797,7 +797,11 @@ def drain_conn(self) -> None:\n         Unread data in the HTTPResponse connection blocks the connection from being released back to the pool.\n         \"\"\"\n         try:\n-            self.read()\n+            self.read(\n+                # Do not spend resources decoding the content unless\n+                # decoding has already been initiated.\n+                decode_content=self._has_decoded_content,\n+            )\n         except (HTTPError, OSError, BaseSSLError, HTTPException):\n             pass\n "},{"sha":"8d6107aea03915a62344b2e82228a8eb3535e811","filename":"test/with_dummyserver/test_connectionpool.py","status":"modified","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/urllib3/urllib3/blob/8864ac407bba8607950025e0979c4c69bc7abc7b/test%2Fwith_dummyserver%2Ftest_connectionpool.py","raw_url":"https://github.com/urllib3/urllib3/raw/8864ac407bba8607950025e0979c4c69bc7abc7b/test%2Fwith_dummyserver%2Ftest_connectionpool.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Fwith_dummyserver%2Ftest_connectionpool.py?ref=8864ac407bba8607950025e0979c4c69bc7abc7b","patch":"@@ -508,6 +508,25 @@ def test_redirect(self) -> None:\n             assert r.status == 200\n             assert r.data == b\"Dummy server!\"\n \n+    @mock.patch(\"urllib3.response.GzipDecoder.decompress\")\n+    def test_no_decoding_with_redirect_when_preload_disabled(\n+        self, gzip_decompress: mock.MagicMock\n+    ) -> None:\n+        \"\"\"\n+        Test that urllib3 does not attempt to decode a gzipped redirect\n+        response when `preload_content` is set to `False`.\n+        \"\"\"\n+        with HTTPConnectionPool(self.host, self.port) as pool:\n+            # Three requests are expected: two redirects and one final / 200 OK.\n+            response = pool.request(\n+                \"GET\",\n+                \"/redirect\",\n+                fields={\"target\": \"/redirect?compressed=true\", \"compressed\": \"true\"},\n+                preload_content=False,\n+            )\n+        assert response.status == 200\n+        gzip_decompress.assert_not_called()\n+\n     def test_303_redirect_makes_request_lose_body(self) -> None:\n         with HTTPConnectionPool(self.host, self.port) as pool:\n             response = pool.request("}]}