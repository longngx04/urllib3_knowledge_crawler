flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5e3432646ad63749ff0d655c157fe293cdc6c2aa","url":"https://api.github.com/repos/urllib3/urllib3/commits/5e3432646ad63749ff0d655c157fe293cdc6c2aa","html_url":"https://github.com/urllib3/urllib3/commit/5e3432646ad63749ff0d655c157fe293cdc6c2aa"}],"stats":{"total":37,"additions":37,"deletions":0},"files":[{"sha":"45580b7e1ea6835a328c0cb41fa41053873b58d5","filename":"src/urllib3/connection.py","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/urllib3/urllib3/blob/8d65ea1ecf6e2cdc27d42124e587c1b83a3118b0/src%2Furllib3%2Fconnection.py","raw_url":"https://github.com/urllib3/urllib3/raw/8d65ea1ecf6e2cdc27d42124e587c1b83a3118b0/src%2Furllib3%2Fconnection.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/src%2Furllib3%2Fconnection.py?ref=8d65ea1ecf6e2cdc27d42124e587c1b83a3118b0","patch":"@@ -490,6 +490,10 @@ def _connect_tls_proxy(self, hostname, conn):\n             self.ca_cert_dir,\n             self.ca_cert_data,\n         )\n+        # By default urllib3's SSLContext disables `check_hostname` and uses\n+        # a custom check. For proxies we're good with relying on the default\n+        # verification.\n+        ssl_context.check_hostname = True\n \n         # If no cert was provided, use only the default options for server\n         # certificate validation"},{"sha":"96c9b2b5bc4279d52fe86262cc627b2b23c169ad","filename":"test/conftest.py","status":"modified","additions":11,"deletions":0,"changes":11,"blob_url":"https://github.com/urllib3/urllib3/blob/8d65ea1ecf6e2cdc27d42124e587c1b83a3118b0/test%2Fconftest.py","raw_url":"https://github.com/urllib3/urllib3/raw/8d65ea1ecf6e2cdc27d42124e587c1b83a3118b0/test%2Fconftest.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Fconftest.py?ref=8d65ea1ecf6e2cdc27d42124e587c1b83a3118b0","patch":"@@ -64,6 +64,17 @@ def no_san_server(tmp_path_factory):\n         yield cfg\n \n \n+@pytest.fixture\n+def no_localhost_san_server(tmp_path_factory):\n+    tmpdir = tmp_path_factory.mktemp(\"certs\")\n+    ca = trustme.CA()\n+    # non localhost common name\n+    server_cert = ca.issue_cert(u\"example.com\")\n+\n+    with run_server_in_thread(\"https\", \"localhost\", tmpdir, ca, server_cert) as cfg:\n+        yield cfg\n+\n+\n @pytest.fixture\n def ip_san_server(tmp_path_factory):\n     tmpdir = tmp_path_factory.mktemp(\"certs\")"},{"sha":"c1535bd08774847fa85777c84a7fca09ac236c8d","filename":"test/with_dummyserver/test_proxy_poolmanager.py","status":"modified","additions":22,"deletions":0,"changes":22,"blob_url":"https://github.com/urllib3/urllib3/blob/8d65ea1ecf6e2cdc27d42124e587c1b83a3118b0/test%2Fwith_dummyserver%2Ftest_proxy_poolmanager.py","raw_url":"https://github.com/urllib3/urllib3/raw/8d65ea1ecf6e2cdc27d42124e587c1b83a3118b0/test%2Fwith_dummyserver%2Ftest_proxy_poolmanager.py","contents_url":"https://api.github.com/repos/urllib3/urllib3/contents/test%2Fwith_dummyserver%2Ftest_proxy_poolmanager.py?ref=8d65ea1ecf6e2cdc27d42124e587c1b83a3118b0","patch":"@@ -543,3 +543,25 @@ def test_basic_ipv6_proxy(self):\n \n             r = http.request(\"GET\", \"%s/\" % self.https_url)\n             assert r.status == 200\n+\n+\n+class TestHTTPSProxyVerification:\n+    @onlyPy3\n+    def test_https_proxy_hostname_verification(self, no_localhost_san_server):\n+        bad_server = no_localhost_san_server\n+        bad_proxy_url = \"https://%s:%s\" % (bad_server.host, bad_server.port)\n+\n+        # An exception will be raised before we contact the destination domain.\n+        test_url = \"testing.com\"\n+        with proxy_from_url(bad_proxy_url, ca_certs=bad_server.ca_certs) as https:\n+            with pytest.raises(MaxRetryError) as e:\n+                https.request(\"GET\", \"http://%s/\" % test_url)\n+            assert isinstance(e.value.reason, SSLError)\n+            assert \"hostname 'localhost' doesn't match\" in str(e.value.reason)\n+\n+            with pytest.raises(MaxRetryError) as e:\n+                https.request(\"GET\", \"https://%s/\" % test_url)\n+            assert isinstance(e.value.reason, SSLError)\n+            assert \"hostname 'localhost' doesn't match\" in str(\n+                e.value.reason\n+            ) or \"Hostname mismatch\" in str(e.value.reason)"}]}