{"sha":"5b047b645f5f93900d5e2fc31230848c25eb1f5f","node_id":"MDY6Q29tbWl0MjQxMDY3Njo1YjA0N2I2NDVmNWY5MzkwMGQ1ZTJmYzMxMjMwODQ4YzI1ZWIxZjVm","commit":{"author":{"name":"Seth Michael Larson","email":"sethmichaellarson@gmail.com","date":"2019-07-26T15:42:51Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2019-07-26T15:42:51Z"},"message":"Percent-encode invalid characters within auth section (#1647)","tree":{"sha":"99693b63e5f03ff56249a183f3f58f5d434eaa66","url":"https://api.github.com/repos/urllib3/urllib3/git/trees/99693b63e5f03ff56249a183f3f58f5d434eaa66"},"url":"https://api.github.com/repos/urllib3/urllib3/git/commits/5b047b645f5f93900d5e2fc31230848c25eb1f5f","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsBcBAABCAAQBQJdOx97CRBK7hj4Ov3rIwAAdHIIAEktvg6dQUOZVT0Yxtt65gRx\n0N2sX/cbsNCmizmft8S9oM8VEPI7n7LiOLs8pMhe5MjEaTn6yIob+rGR/Z03aIb+\nrLEc+U5V5OJgQEVq1tEmY2AjHf2OMuN+vsj0Ig1XDT7kDwhraGWR6bO6OB8WjPZe\nHmEnEjYU6ZYJnEd6H8lBpdBQ5Ia+imZzgM7k81IlOvsB6XK+/scHGoN6u+MkBn6L\nhSW6Rfp/gqfkSeiISRprhjtQt6nnTbqxXkU5cXEd1aTOalqBpu4JTGdVGEvgfHvh\nvlK0HZCeWAmWUfv/K3GhvesLP/7JoMChX8b4mynGxU4bmAMdwDMZ7okUTuoPwpQ=\n=C3MS\n-----END PGP SIGNATURE-----\n","payload":"tree 99693b63e5f03ff56249a183f3f58f5d434eaa66\nparent 15acc9f8b4c88942123bd966b0c60a9075605a62\nauthor Seth Michael Larson <sethmichaellarson@gmail.com> 1564155771 -0500\ncommitter GitHub <noreply@github.com> 1564155771 -0500\n\nPercent-encode invalid characters within auth section (#1647)\n\n","verified_at":"2024-01-16T19:59:59Z"}},"url":"https://api.github.com/repos/urllib3/urllib3/commits/5b047b645f5f93900d5e2fc31230848c25eb1f5f","html_url":"https://github.com/urllib3/urllib3/commit/5b047b645f5f93900d5e2fc31230848c25eb1f5f","comments_url":"https://api.github.com/repos/urllib3/urllib3/commits/5b047b645f5f93900d5e2fc31230848c25eb1f5f/comments","author":{"login":"sethmlarson","id":18519037,"node_id":"MDQ6VXNlcjE4NTE5MDM3","avatar_url":"https://